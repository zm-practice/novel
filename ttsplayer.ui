   </size>
  </property>
  <property name="windowTitle">
   <string>听书播放器</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#TtsPlayer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #F8F9FA, stop:1 #E9ECEF);
    border-radius: 15px;
}

QPushButton {
    background-color: #AEC6CF;
    color: #2C3E50;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #BBD1D9;
}

QPushButton:pressed {
    background-color: #9FB7BF;
}

QPushButton#playButton, QPushButton#pauseButton {
    min-width: 100px;
    min-height: 45px;
    font-size: 14px;
    background-color: #5DADE2;
    color: white;
}

QPushButton#playButton:hover, QPushButton#pauseButton:hover {
    background-color: #3498DB;
}

QPushButton#prevButton, QPushButton#nextButton {
    min-width: 90px;
    min-height: 40px;
}

QPushButton#closeButton {
    background-color: #E74C3C;
    color: white;
    min-width: 80px;
    min-height: 35px;
}

QPushButton#closeButton:hover {
    background-color: #C0392B;
}

QSlider::groove:horizontal {
    border: 1px solid #BDBDBD;
    height: 8px;
    background: #E0E0E0;
    margin: 2px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #5DADE2;
    border: 2px solid #3498DB;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #3498DB;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5DADE2, stop:1 #3498DB);
    border: 1px solid #3498DB;
    height: 8px;
    border-radius: 4px;
}

QLabel#titleLabel {
    color: #2C3E50;
    font-size: 16px;
    font-weight: bold;
}

QLabel#infoLabel {
    color: #546E7A;
    font-size: 13px;
}

QLabel#progressLabel {
    color: #5DADE2;
    font-size: 14px;
    font-weight: bold;
}

QFrame#separatorLine {
    background-color: #CFD8DC;
}</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <property name="spacing">
