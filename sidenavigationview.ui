      </item>
      <item>
       <widget class="QToolButton" name="bookshelfButton">
        <property name="minimumSize">
         <size>
          <width>100</width>
          <height>20</height>
         </size>
        </property>
        <property name="font">
         <font>
          <family>楷体</family>
          <pointsize>12</pointsize>
         </font>
        </property>
        <property name="styleSheet">
         <string notr="true">QToolButton {
    /* 1. 【核心】使用 qproperty-icon 来设置图标 */
    /*    请确保 URL 路径是您在资源文件中的正确路径！ */
    qproperty-icon: url(:/icons/bookshelf.png);

    /* 2. 颜色方案 (保持不变) */
    background-color: #FDEBD0;
    border: 1px solid #F5CBA7;
    color: #BF7137;

    /* 3. 布局调整 (保持不变) */
    spacing: 8px; /* 图标和文字的间距 */
    padding: 5px 15px 5px 10px; /* 上 右 下 左 */
    
    /* 4. 其他基础样式 */
    border-radius: 8px;
}

/* 鼠标悬浮状态 (当按钮未被选中时) */
QToolButton:hover:!checked {
    background-color: #FEF5E7;
    border-color: #FAD7A0;
}

/* 选中状态 */
QToolButton:checked {
    background-color: #AEC6CF;
    border-color: #AEC6CF;
    color: white;
}

/* 按下特效 */
QToolButton:pressed {
    background-color: #FAD7A0;
    padding-top: 6px;
    padding-bottom: 4px;
}</string>
        </property>
        <property name="text">
