      <item>
       <widget class="QPushButton" name="timerButton">
        <property name="font">
         <font>
          <family>楷体</family>
          <pointsize>12</pointsize>
         </font>
        </property>
        <property name="styleSheet">
         <string notr="true">
#timerButton {
    /* 1. 让按钮尺寸和你的图片完全一样 */
    /*    假设你的图片是 64x64 像素 */
    min-width: 64px;
    min-height: 64px;
    max-width: 64px;
    max-height: 64px;

    /* 2. 移除按钮自身的背景和边框，让它“隐形” */
    background-color: transparent;
    border: none;

    /* 3. 【核心】将你的图片作为按钮的“边框图片” */
    /*    这会把图片完整地、不失真地铺满整个按钮区域 */
    /*    请务必将路径替换成你资源文件里的真实路径！ */
    border-image: url(:/icons/clock.png);
}

/* 交互效果：当鼠标按下时 */
#timerButton:pressed {
    /* 增加一点内边距，让图片向右下角轻微移动 */
    /* 这会产生一个非常逼真的“被按下”的物理效果 */
    padding-top: 2px;
    padding-left: 2px;
}</string>
        </property>
        <property name="text">
         <string/>
        </property>
        <property name="flat">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="verticalSpacer">
        <property name="orientation">
